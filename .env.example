# Copy to .env and fill in.

NODE_ENV=development
LOG_LEVEL=debug

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000

# Postgres
DATABASE_URL=postgresql://chipid:chipid@localhost:5432/chipid?schema=public

# Redis (rate limiting, idempotency, job queue)
REDIS_URL=redis://localhost:6379

# Secret used to derive HMAC keys for webhook signing and idempotency.
# Generate: openssl rand -base64 48
ROOT_SECRET=replace-me-with-48-bytes-of-randomness

# Trust anchor: BCA Country Signing CA root certificate (PEM).
# In production, mount the real cert via a secret. For sandbox we ship a dev anchor.
CSCA_TRUST_ANCHOR_PATH=./fixtures/csca/dev-csca.pem

# Object storage for chip dumps + portrait images (S3-compatible).
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=chipid-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Stripe (for metered billing of verifications)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Sentry (errors)
SENTRY_DSN=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=chipid-api
