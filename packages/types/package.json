{
  "name": "@chipid/types",
  "version": "0.1.0",
  "description": "Shared TypeScript types for ChipID",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "echo 'no tests'",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@chipid/eslint-config": "workspace:*",
    "eslint": "^10.6.0",
    "typescript": "^6.0.3"
  }
}
