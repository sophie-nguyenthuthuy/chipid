{
  "name": "@chipid/nfc-parser",
  "version": "0.1.0",
  "description": "ICAO 9303 LDS parser and Passive Authentication for CCCD chip dumps",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "asn1js": "^3.0.5",
    "pkijs": "^3.2.4"
  },
  "devDependencies": {
    "@chipid/eslint-config": "workspace:*",
    "@types/node": "^22.7.4",
    "eslint": "^9.11.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
